+#ifdef GDK_WINDOWING_QUARTZ
+/* Native PDF viewers do not implement Evince's --unlink-tempfile protocol.
+ * Keep previews readable after launch and expire only our private cache files.
+ */
+static gchar *
+quartz_preview_directory (GError **error)
+{
+  gchar *directory = g_build_filename (g_get_user_cache_dir (), "gtk-3.0",
+                                       "print-preview", NULL);
+  GDir *dir;
+  const gchar *name;
+  gint64 cutoff = g_get_real_time () / G_USEC_PER_SEC - 7 * 24 * 60 * 60;
+
+  if (g_mkdir_with_parents (directory, 0700) != 0)
+    {
+      g_set_error (error, G_FILE_ERROR, g_file_error_from_errno (errno),
+                   "Cannot create print preview directory: %s", g_strerror (errno));
+      g_free (directory);
+      return NULL;
+    }
+
+  dir = g_dir_open (directory, 0, NULL);
+  if (dir != NULL)
+    {
+      while ((name = g_dir_read_name (dir)) != NULL)
+        {
+          gchar *path;
+          GStatBuf st;
+          if (!g_str_has_prefix (name, "gtk-preview-") ||
+              !g_str_has_suffix (name, ".pdf"))
+            continue;
+          path = g_build_filename (directory, name, NULL);
+          if (g_lstat (path, &st) == 0 && S_ISREG (st.st_mode) &&
+              st.st_mtime < cutoff)
+            g_unlink (path);
+          g_free (path);
+        }
+      g_dir_close (dir);
+    }
+  return directory;
+}
+#endif
