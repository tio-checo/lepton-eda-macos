(use-modules (srfi srfi-64) (system foreign) (lepton config)
             (schematic gtk geometry))
(define runner (test-runner-simple))
(test-runner-current runner)
(test-begin "geometry-cache")
(define cfg (anyfile-config-context
             (string-append (getcwd) "/geometry-test-unused.conf")))
(define geometry (resolve-module '(schematic gtk geometry)))
(define calls '())
;; Keep real config parsing; replace only the native window operations.
(module-set! geometry 'cache-config-context (lambda () cfg))
(module-set! geometry 'gtk_window_move
             (lambda (window x y) (set! calls (cons (list 'move x y) calls))))
(module-set! geometry 'gtk_window_resize
             (lambda (window w h) (set! calls (cons (list 'resize w h) calls))))
(define (restore) (set! calls '()) (restore-gtk-window-geometry %null-pointer "geometry") calls)
(test-equal "missing group" '((resize 800 600)) (restore))
(set-config! cfg "geometry" "x" 10)
(test-equal "partial cache" '((resize 800 600)) (restore))
(set-config! cfg "geometry" "y" 20)
(set-config! cfg "geometry" "width" 1024)
(set-config! cfg "geometry" "height" 768)
(test-equal "valid cache" '((resize 1024 768) (move 10 20)) (restore))
(set-config! cfg "geometry" "width" -2)
(test-equal "invalid size" '((resize 800 600) (move 10 20)) (restore))
(set-config! cfg "geometry" "width" "invalid")
(test-equal "malformed integer" '((resize 800 600) (move 10 20)) (restore))
(test-end "geometry-cache")
(exit (if (zero? (test-runner-fail-count runner)) 0 1))
